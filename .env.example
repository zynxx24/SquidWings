# ============================================
# Agent Router - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# Keep comments on their own line (not after a value).

# --- API Connection ---
# Any OpenAI-compatible endpoint: its URL and key are all it takes. Examples are in the README.
# Optional: providers, URLs and API keys are managed on the Router page (/router). On the first
# start these two are copied there as the "Default" provider.
API_BASE_URL=https://api.openai.com/v1
API_KEY=your-api-key-here

# --- General ---
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
TIMEOUT_SECONDS=120
STREAM_ENABLED=true

# --- Model defaults ---
# Empty lets Auto choose from what your endpoint lists.
DEFAULT_MODEL=
DEFAULT_TEMPERATURE=0.5
DEFAULT_MAX_TOKENS=8192

# --- Web server ---
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Comma-separated extras. Default: same-origin requests from this machine only.
WEB_ALLOWED_ORIGINS=
WEB_ALLOWED_HOSTS=
WEB_MAX_USERS=10
WEB_RATE_LIMIT_RPM=600

# --- Agent harness ---
# Tools for the web chat and teams. They run on this machine, under security/policy.yaml.
AGENT_TOOLS_ENABLED=true
# Comma-separated tools to refuse, for example: execute_command,file_delete
AGENT_DISABLED_TOOLS=
# Let stuck runs consult (and finally hand over to) a stronger, more expensive model.
HARNESS_ADVISOR=true
# History sent per request, however large the model's window is.
HISTORY_MAX_TOKENS=24000
# Folder of your own skills: *.md files, or folders with a SKILL.md. A skill there
# replaces a built-in of the same name.
SKILLS_DIR=
# Skills to leave out, comma-separated. Example: animate,build-web
SKILLS_DISABLED=
# Extra providers (URLs, keys, limits). Default: config/providers.yaml
PROVIDERS_CONFIG=
# Router page (/router): your own OpenAI- and Claude-compatible providers and keys are added there,
# not here. Where they and the token log are kept (default web/data/router):
# ROUTER_STORE_DIR=
# Token log rows older than this many days are deleted.
# ROUTER_USAGE_KEEP_DAYS=400
# 0 = do not copy API_BASE_URL/API_KEY (and pairs like BANSOS_API_BASE_URL/BANSOS_API_KEY) to the
# Router page on the first start. After that copy, URLs and keys are managed on the page, and the
# values above may be removed. Lock tunnel edits with a PIN on the page, not here.
# ROUTER_IMPORT_ENV=1
# Team canvas (multi-agent). Leave unset to decide from APP_ENV:
# development = chat only, anything else = team canvas on.
WEB_TEAMS_ENABLED=
# Limits for one team request. Raise them if big build tasks stop too early.
# TEAM_RUN_SECONDS=600
# TEAM_MEMBER_SECONDS=240
# TEAM_MEMBER_ROUNDS=10
# TEAM_MEMBER_TOKENS=120000
# Teams in video mode (build and render video) get these instead.
# TEAM_VIDEO_RUN_SECONDS=3600
# TEAM_VIDEO_MEMBER_SECONDS=1800
# TEAM_VIDEO_MEMBER_ROUNDS=40
# TEAM_VIDEO_MEMBER_TOKENS=400000

# Telegram for team flows: sending results, and starting a flow with a message.
# Create a bot with @BotFather. Only messages from TELEGRAM_CHAT_ID start a flow.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Databases a flow can save to. SQLite works with no setup.
# TEAM_DB_SQLITE_PATH=web/data/teams/flow.sqlite3
# TEAM_DB_POSTGRES_URL=postgresql://user:password@localhost:5432/nama_db
# TEAM_DB_MYSQL_URL=mysql://user:password@localhost:3306/nama_db
# TEAM_DB_MONGODB_URL=mongodb://localhost:27017/nama_db

# --- Workspace ---
# Root folder for files saved by chat/CLI. Each session gets workspace/<session_id>/
SQUIDWINGS_WORKSPACE=

# --- Brain: Ponytail (response style) ---
# off | lite | full | ultra
PONYTAIL_MODE=full
# Comma-separated task types that get the Ponytail prompt (e.g. code,reason)
PONYTAIL_TASKS=code

# --- Memory: chat history ---
# Max characters of the summary that replaces history that does not fit. 0 = disable.
HISTORY_SUMMARY_CHARS=600
# Summary is kept only if it uses <= 1/N of the history budget.
HISTORY_SUMMARY_SHARE=4

# --- Memory: Obsidian vault ---
WEB_SEARCH_OBSIDIAN_ENABLED=false
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SEARCH_FOLDER=SquidWings/Web Search

# --- Memory: Graphify ---
GRAPHIFY_MEMORY_ENABLED=false
GRAPHIFY_MEMORY_ENDPOINT=
GRAPHIFY_MEMORY_TIMEOUT_SECONDS=5

# --- Web search ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_TTL_SECONDS=21600

# --- Uploads (MarkItDown) ---
MAX_UPLOAD_MB=20
MAX_UPLOAD_CHARS=120000
# Text put in the message. Longer documents keep their headings, and the full text is saved in the chat's folder.
UPLOAD_INLINE_CHARS=30000
# Reads images and scanned pages into text on this machine. No model call and no internet.
DOCUMENT_OCR=true
OCR_MAX_IMAGES=20
# true sends an uploaded picture to the model too. Only for a model that can see.
SEND_IMAGES=false
# Images sent to vision models: max images per message and longest side in px
MAX_CHAT_IMAGES=4
IMAGE_MAX_SIDE=1536
# Video is a DRAFT feature (needs ffmpeg + speech transcription). Audio upload is not supported.
VIDEO_UPLOAD_ENABLED=false

# --- Security / audit ---
SQUIDWINGS_AUDIT_LOG=audit.jsonl
SQUIDWINGS_VAULT=.vault.json
SQUIDWINGS_VAULT_PASSPHRASE=

# --- Command sandbox ---
# auto: bubblewrap, then Docker. With neither, agent commands are refused.
# off: commands run directly on this machine.
SANDBOX_MODE=auto
# Internet for agent commands. Needed for pip install, npm install, and curl.
SANDBOX_NETWORK=false
# Address-space limit. 0 means none, because Node reserves far more than it uses.
SANDBOX_MEMORY_MB=0
# CPU seconds per command. A minute of 1080p video takes a few hundred to render.
SANDBOX_CPU_SECONDS=900
SANDBOX_FILE_SIZE_MB=1024
# Image for the Docker backend.
SANDBOX_IMAGE=python:3.12-slim
# Extra read-only folders, comma-separated.
SANDBOX_RO_PATHS=

# Web search. Without these the agent uses public result pages, which are often weak.
# SEARXNG_URL=http://localhost:8888
# BRAVE_SEARCH_API_KEY=
# WEB_BROWSER_ENABLED=true

# ---- MT5 trading panel (/trading) ----
# Viewing never needs a token, from anywhere. Sending orders from this computer needs none either.
# From a tunnel or another machine, sending orders needs this token...
MT5_TRADE_TOKEN=
# ...unless this is 1: then anyone with the tunnel URL can trade. Never with a real-money account.
TRADING_REMOTE_NO_TOKEN=0
# Where the chat agent's trading_snapshot tool reads the trading server (this machine only).
# TRADING_SERVER_URL=http://127.0.0.1
# Largest volume (lots) per order.
MT5_MAX_VOLUME=0.10
# 1 = every order needs a stop loss.
MT5_REQUIRE_SL=1
# 1 = allow a real-money account. Keep 0 while testing on a demo account.
MT5_ALLOW_LIVE=0
# Largest loss at the stop, in percent of equity. Refuses a stop too far away to protect anything.
MT5_MAX_RISK_PCT=5

# ---- MT4 EA bridge (trading/mt4/Mt4Bridge.mq4) ----
# Shared secret; the same value goes in the EA's BridgeSecret input. Empty = bridge off.
MT4_BRIDGE_SECRET=
# Where the trade journal (orders, closes, loss report data) is written.
# TRADE_JOURNAL=trading/data/journal.jsonl

# ---- Quant proposal and risk limits (trading/quant) ----
# Risk per trade in percent of equity. Above 1 is refused on purpose.
# QUANT_RISK_PER_TRADE=0.25
# Limits from your funded-program rules. Read them from the firm; they differ by program.
# QUANT_FIRM_DAILY_LOSS_PCT=5
# QUANT_FIRM_MAX_LOSS_PCT=10
# QUANT_MAX_OPEN=1
# QUANT_MAX_CONSECUTIVE_LOSSES=3
# UTC hours with no new entries (rollover). Empty = no filter.
# QUANT_BLOCK_HOURS_UTC=21,22
# Smallest proposal score (0-100) that may trade. 0 = the score only explains.
# QUANT_MIN_SCORE=0
# High-impact news as a JSON list: [{"time":"2026-11-04T12:30:00Z","currency":"USD","impact":"high","title":"NFP"}]
# TRADE_NEWS_FILE=
# 0 stops recording the EA's live quotes to trading/data/ticks (needed for the 30-second backtest).
# MT4_RECORD_TICKS=1
# Model that adjusts the scalp backtest after losses. Empty uses DEFAULT_MODEL.
# SCALP_LLM_MODEL=

# ---- Model list and local tools ----
# How often the model list is fetched again, in seconds. 0 turns it off.
MODEL_SYNC_EVERY_S=1800
# Upgrades graphify and aislop once a day. This changes global installs.
TOOLS_AUTO_UPDATE=true
