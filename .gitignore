# Everything is published (AGPL-3.0), including the trading and Studio modules.
# Only secrets, private data (chats, memory, vault, logs, trading journal and model weights),
# internal notes, and generated or cached files stay out.
# A leading "/" means the project root. Without it, "vault/" also hides
# tools/local_memory/vault/, which is source code.

# === Secrets ===
task/
.env
.env.*
!.env.example
.vault.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
secrets.json
secrets.yaml
secrets.yml

# === Private data: chats, memory, notes, audit results ===
/workspace/
/vault/
# Logs, the audit chain, reports, archives (core/config/paths.py)
/data/
# Left by servers started before the 2026-11 restructure; real data lives in addons/trading/data/
/trading/
/brain/skills/
brain/memory/chat_store/
brain/memory/store/
web/data/
.agent_memory/
.agent_backups/
.vault/
graphify-out/
audit.jsonl
*.jsonl
*.db
*.sqlite3
*.log

# === Docs: README.md and docs/ are public, plus the skills the agent loads ===
.internal/
*.md
!README.md
!**/README.md
!/CLAUDE.md
!docs/*.md
!skills/*.md
!skills/*/**/*.md
!skills/*/*.md
!addons/*/README.md
!addons/*/skills/*.md
!addons/*/skills/*/**/*.md
!web/static/vendor/fonts/LICENSE.md
add_model.md

# === Local tooling ===
.claude/
.relaycode.json
.vscode/
.idea/
*.swp
*.swo
*~

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
.venv-*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# === Generated JSON. Add an exception here if a config file must be published ===
*.json
!skills/*/**/*.json
!skills/sources.json
!addons/*/addon.json
!addons/*/skills/*/**/*.json
!tests/eval_data/*.json

# === Backups, archives, media ===
*.bak
*.tar.gz
*.zip
*.orphan
_t.py
Screenshot_*.png

# === OS ===
.DS_Store
Thumbs.db

# === Stale lock file. requirements.lock is the real one ===
uv.lock

# Trading data: trade journal, candle history, ticks, model weights (user data, large files)
addons/trading/data/
# Which add-ons are switched on on this machine (python main.py addon install ...)
addons/enabled.json
# The Studio's compiled render engine (built on each machine from addons/studio/engine/sqengine.c)
addons/studio/engine/bin/

# Per-port tunnel logs (tunnel.sh, main.py trading --tunnel)
tunnel-*.log

# Skills cloned from GitHub (skills/sources.json); fetched at start-up, never committed
skills/.sources/

# IDE add-on editor build (npm install in addons/ide/build)
addons/ide/build/node_modules/
