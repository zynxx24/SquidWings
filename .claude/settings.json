{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/check_all.sh)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/ruff check:*)",
      "Bash(.venv/bin/mypy:*)",
      "Bash(.venv/bin/python scripts/sync_agent_config.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./web/data/credentials.json)",
      "Read(./web/data/router/**)",
      "Read(~/.local/share/squidwings/web/data/credentials.json)",
      "Read(~/.local/share/squidwings/web/data/router/**)",
      "Read(~/.local/share/squidwings/data/web_access.json)",
      "Read(~/.ssh/id_*)",
      "Read(~/.codex/auth.json)"
    ]
  }
}
