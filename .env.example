# ============================================
# Agent Router — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# --- API Connection ---
API_BASE_URL=http://localhost:20128/v1
API_KEY=your-api-key-here

# --- General Settings ---
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR, CRITICAL
MAX_RETRIES=3                   # Max retry attempts for API calls
RETRY_BACKOFF_FACTOR=1.5        # Exponential backoff multiplier
TIMEOUT_SECONDS=120             # HTTP request timeout
STREAM_ENABLED=true             # Enable streaming responses

# --- Model Defaults ---
DEFAULT_MODEL=ag/gemini-3.8-flash-high   # Default model if routing fails
DEFAULT_TEMPERATURE=0.5         # Default temperature
DEFAULT_MAX_TOKENS=8192         # Default max output tokens

# --- Safety ---
SANDBOX_ENABLED=true            # Enable sandboxed tool execution
MAX_TOOL_ITERATIONS=10          # Max tool call loop iterations
COMMAND_TIMEOUT=30              # Max seconds for command execution
